# Copy this file to ".env" and fill in the values.

# ── User accounts (Supabase) ──────────────────────────────────────
# From Supabase Dashboard → Project Settings → API.
# The anon key is public/safe to expose in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "1" ONLY after Google is configured in Supabase (Authentication →
# Providers → Google). Shows the "Continue with Google" button when set.
VITE_GOOGLE_AUTH=

# ── Existing services (leave as-is if already configured) ─────────
VITE_CLAUDE_KEY=
PEXELS_API_KEY=
SALLING_API_KEY=
